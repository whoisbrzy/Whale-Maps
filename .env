# Copy to .env for local use, or set these as environment variables in your host's panel.
# NEVER commit real values. .env is gitignored.

# Discord application (https://discord.com/developers/applications -> your app -> OAuth2)
DISCORD_CLIENT_ID=1559453159523356722
DISCORD_CLIENT_SECRET=ulm_UGyix_Nm98S86qwC1I-1Uc4nuvpm

# Random string, 16+ characters, used to sign login cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it logs everyone out.
SESSION_SECRET=

# The public address of the site, no trailing slash. The Discord redirect URI is this + /auth/callback
PUBLIC_URL=https://trywhale.vercel.app

# Optional
# PORT=3000            (also reads SERVER_PORT, which some game/bot panels set)
# TRUST_PROXY=1        (set when behind a reverse proxy so rate limiting sees real client IPs)
