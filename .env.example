# Waylo environment variables. Copy to .env for local development
# (never commit .env). On Vercel, set these in Project Settings -> Environment Variables.

# ---- Discord login (required for login) ----
# Create an app at https://discord.com/developers/applications, OAuth2 page:
# copy Client ID + Client Secret, and register the redirect
#   PUBLIC_URL + /auth/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Random 16+ characters used to sign session/state cookies.
SESSION_SECRET=

# Public origin of the site, no trailing slash. Local dev: http://localhost:3000
# (or http://localhost:5173 when using `npm run dev` hot reload).
# On Vercel this is normally unnecessary (the production URL is auto-detected).
PUBLIC_URL=

# ---- Dock / Roblox verification (optional) ----
# API key and PID (project id) from the Dock dashboard (https://docksys.xyz).
DOCK_API_KEY=
DOCK_PID=
# Optional Discord guild id passed to Dock sessions.
DOCK_GUILD_ID=
# Overrides for testing against a fake Dock. Never set in production.
# DOCK_API_BASE=
# DOCK_API_VERSION=v1

# ---- MongoDB Atlas (optional; without it accounts live in the cookie only) ----
MONGODB_URI=
MONGODB_DB=whalemaps

# ---- Local server only (server.js; not used on Vercel) ----
# PORT=3000
# HOST=0.0.0.0
# Set to 1 behind a proxy that sets X-Forwarded-For, for correct rate limits.
# TRUST_PROXY=1

# ---- Test-only overrides. Never set these in production. ----
# DISCORD_API=            (fake Discord API base)
# ROBLOX_USERS_API=       (fake Roblox users API base)

# ---- Developer panel ----
# Discord user IDs allowed into /panel (comma-separated). Defaults to the three founders.
DEVELOPER_IDS=
