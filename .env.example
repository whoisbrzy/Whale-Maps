# Copy to .env for local use. On Vercel set these in Project Settings -> Environment Variables.
# NEVER commit real values. .env is gitignored.

# --- Discord login (https://discord.com/developers/applications -> your app -> OAuth2) ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Random string, 16+ characters, signs login cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it logs everyone out.
SESSION_SECRET=
# Exact public address, no trailing slash. Discord redirect URI = this + /auth/callback
# (on Vercel it falls back to your production domain if you leave it empty)
PUBLIC_URL=https://your-site.example

# --- Roblox verification via Dock (https://docs.docksys.xyz) ---
# API key and PID are created in the Dock dashboard. Server-side only, never in the browser.
DOCK_API_KEY=
DOCK_PID=
# Optional: limit lookups/sessions to your Discord server (needed for guild-scoped keys)
# DOCK_GUILD_ID=
# Optional: "v2" (default) or "v1" if Dock's v2 paths don't work for your key
# DOCK_API_VERSION=v2

# --- MongoDB Atlas (stores Discord profile + Roblox link) ---
# Without it the site works, but the Roblox link only lives in the login cookie.
MONGODB_URI=
# MONGODB_DB=whalemaps

# --- Optional ---
# PORT=3000          (local server only)
# TRUST_PROXY=1      (self-hosting behind a reverse proxy; automatic on Vercel)
